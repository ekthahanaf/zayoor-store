# Copy this file to .env  (or just run: npm run setup)
PORT=3000
NODE_ENV=development

# Long random string. `npm run setup` generates one for you.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=7

# First admin account (created automatically on first start)
ADMIN_EMAIL=admin@zayoor.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Store Admin

# Store settings
STORE_NAME=Zayoor
CURRENCY=Rs.
SHIPPING_FEE=200
FREE_SHIPPING_OVER=3000
